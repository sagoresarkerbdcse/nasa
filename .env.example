# AI analyst via OpenRouter (low cost). Without any key the free offline analyst answers.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# Hard spending cap in USD (ledger: .firecal/spend.json)
# FIRECAL_BUDGET_USD=1.5
# Which requests use the LLM: chat, brief, insight
# FIRECAL_LLM_MODES=chat,brief

# Alternative: Anthropic API directly
ANTHROPIC_API_KEY=
# FIRECAL_MODEL=claude-opus-5-5

# NASA FIRMS key for current-year top-ups: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
